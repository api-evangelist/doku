              "mode": "raw",
              "raw": "{\n  \"order\": {\n    \"amount\": \"<integer>\",\n    \"invoice_number\": \"<string>\",\n    \"currency\": \"<string>\"\n  },\n  \"payment\": {\n    \"payment_due_date\": \"<integer>\"\n  },\n  \"customer\": {\n    \"name\": \"<string>\",\n    \"email\": \"<string>\"\n  }\n}",
