              ],
              "body": "{\n  \"responseCode\": \"string\",\n  \"responseMessage\": \"string\",\n  \"accessToken\": \"string\",\n  \"tokenType\": \"Bearer\",\n  \"expiresIn\": \"900\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
